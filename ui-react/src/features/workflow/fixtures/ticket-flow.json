      "config": { "method": "POST", "url": "https://api.example.com/ticket", "headers": { "X-Source": "workflow" }, "body": "{\"text\":\"${answer}\"}" }
    },
    {
      "id": "node_end_1",
      "type": "END",
      "name": "结束",
