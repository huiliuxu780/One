    },
    {
      "id": "node_if_1",
      "type": "IF_ELSE",
      "name": "满意度判断",
      "position": { "x": 660, "y": 150 },
      "config": { "branches": [{ "expression": "${answer}.contains('投诉')", "label": "升级人工" }, { "label": "默认" }] }
    },
    {
      "id": "node_http_1",
      "type": "HTTP",
      "name": "创建工单",
