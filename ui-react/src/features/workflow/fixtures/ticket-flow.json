{
  "metadata": { "schemaVersion": "1.0", "nodeVersion": "8" },
  "nodes": [
    {
      "id": "node_start_1",
      "type": "START",
      "name": "开始",
      "position": { "x": 80, "y": 160 },
      "config": { "inputs": [{ "name": "question", "sourceType": "CONSTANT", "type": "STRING", "value": "" }] }
    },
    {
      "id": "node_agent_1",
      "type": "AGENT",
      "name": "客服坐席",
