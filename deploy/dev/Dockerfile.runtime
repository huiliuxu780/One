FROM eclipse-temurin:21-jre

WORKDIR /app
RUN apt-get update \
    && apt-get install -y --no-install-recommends python3 python3-pip python3-venv curl ca-certificates \
    && ln -sf /usr/bin/python3 /usr/bin/python \
    && curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && rm -rf /var/lib/apt/lists/* \
    && mkdir -p /app/data /app/logs /app/.apboa

COPY runner-runtime/target/runner-runtime-*.jar /app/app.jar
COPY docker/runtime/entrypoint.sh /app/entrypoint.sh
RUN chmod 0755 /app/entrypoint.sh

EXPOSE 3061
ENV TZ=Asia/Shanghai
ENV PATH="/opt/tools/npm-global/bin:${PATH}"
ENTRYPOINT ["/app/entrypoint.sh"]
